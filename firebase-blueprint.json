{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Administrator", "Manager", "Employee"] },
        "companyName": { "type": "string" },
        "crNumber": { "type": "string" },
        "city": { "type": "string" },
        "avatar": { "type": "string" },
        "dashboardConfig": { "type": "string" },
        "notificationSettings": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "HR Employee record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "string" },
        "department": { "type": "string" },
        "nationality": { "type": "string" },
        "iqamaExpiry": { "type": "string" },
        "wpsStatus": { "type": "string" },
        "baseSalaryHalalas": { "type": "integer" },
        "housingAllowanceHalalas": { "type": "integer" },
        "transportAllowanceHalalas": { "type": "integer" },
        "otherDeductionsHalalas": { "type": "integer" },
        "bank": { "type": "string" },
        "iban": { "type": "string" },
        "status": { "type": "string" },
        "joinedDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing invoice",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "number": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "issueDate": { "type": "string", "format": "date-time" },
        "totalAmountHalalas": { "type": "integer" },
        "status": { "type": "string" },
        "lineItems": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit trail",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "module": { "type": "string" },
        "action": { "type": "string" },
        "payload": { "type": "string" },
        "result": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "relatedId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Lead": {
      "title": "Lead",
      "description": "CRM Lead",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string" },
        "expectedCloseDate": { "type": "string", "format": "date-time" }
      }
    },
    "Shipment": {
      "title": "Shipment",
      "description": "Logistics shipment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "supplierName": { "type": "string" },
        "productDescription": { "type": "string" },
        "countryOfOrigin": { "type": "string" },
        "status": { "type": "string" },
        "carrier": { "type": "string" },
        "trackingNumber": { "type": "string" }
      }
    },
    "Broker": {
      "title": "Broker",
      "description": "Customs Broker",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "ShipmentDocument": {
      "title": "ShipmentDocument",
      "description": "Shipment document record",
      "type": "object",
      "properties": {
        "documentType": { "type": "string" },
        "fileUrl": { "type": "string" },
        "validationStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ShipmentComment": {
      "title": "ShipmentComment",
      "description": "Shipment comment",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ShipmentEvent": {
      "title": "ShipmentEvent",
      "description": "Shipment lifecycle event",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "Anti-Concealment Audit Trail transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "nationalId": { "type": "string" },
        "amountHalalas": { "type": "integer" },
        "isOwner": { "type": "boolean" },
        "needsOwnerVerification": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["verified", "pending", "rejected"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "An employee leave request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdvanceRequest": {
      "title": "AdvanceRequest",
      "description": "An employee advance salary request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "amount": { "type": "number" },
        "installments": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CostCenter": {
      "title": "CostCenter",
      "description": "Hierarchical Cost Center (Project, Branch, Department)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "type": { "type": "string", "enum": ["Project", "Branch", "Department", "Other"] },
        "parentId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "FixedAsset": {
      "title": "FixedAsset",
      "description": "Fixed Asset for Depreciation Management",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "assetCode": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "historicalValueHalalas": { "type": "integer" },
        "depreciationRate": { "type": "number" },
        "depreciationMethod": { "type": "string", "enum": ["straight_line", "diminishing_balance"] },
        "accumulatedDepreciationHalalas": { "type": "integer" },
        "currentBookValueHalalas": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "disposed"] },
        "createdAt": { "type": "string" },
        "lastDepreciationDate": { "type": "string" }
      }
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Direct receipt or payment voucher with multi-currency",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "number": { "type": "string" },
        "type": { "type": "string", "enum": ["receipt", "payment"] },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "amountSar": { "type": "number" },
        "accountFromId": { "type": "string" },
        "accountToId": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "status": { "type": "string", "enum": ["posted", "draft"] },
        "createdAt": { "type": "string" }
      }
    },
    "PayrollTemplate": {
      "title": "PayrollTemplate",
      "description": "Saved payroll template for an employee group",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "targetDepartment": { "type": "string" },
        "defaultBaseSalaryHalalas": { "type": "integer" },
        "defaultHousingAllowanceHalalas": { "type": "integer" },
        "defaultTransportAllowanceHalalas": { "type": "integer" },
        "gosiNationalityRule": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "User profiles" },
    "employees": { "schema": "Employee", "description": "HR Employees" },
    "invoices": { "schema": "Invoice", "description": "Invoices" },
    "audit_logs": { "schema": "AuditLog", "description": "Audit trail" },
    "notifications": { "schema": "Notification", "description": "Notifications" },
    "leads": { "schema": "Lead", "description": "CRM Leads" },
    "shipments": { "schema": "Shipment", "description": "Logistics shipments" },
    "brokers": { "schema": "Broker", "description": "Brokers" },
    "shipments/{shipmentId}/documents": { "schema": "ShipmentDocument", "description": "Shipment documents" },
    "shipments/{shipmentId}/comments": { "schema": "ShipmentComment", "description": "Shipment comments" },
    "shipments/{shipmentId}/events": { "schema": "ShipmentEvent", "description": "Shipment events" },
    "financial_transactions": { "schema": "FinancialTransaction", "description": "Anti-Concealment Audit Trail" },
    "leave_requests": { "schema": "LeaveRequest", "description": "Employee leave requests" },
    "advance_requests": { "schema": "AdvanceRequest", "description": "Salary advance requests" },
    "cost_centers": { "schema": "CostCenter", "description": "Hierarchical cost centers" },
    "fixed_assets": { "schema": "FixedAsset", "description": "Fixed Assets" },
    "chart_of_accounts": { "schema": "object", "description": "Chart of accounts" },
    "journal_entries": { "schema": "object", "description": "General journal entries" },
    "vouchers": { "schema": "Voucher", "description": "Receipt & Payment Vouchers" },
    "bank_reconciliations": { "schema": "object", "description": "Bank Reconciliation lists" },
    "payroll_templates": { "schema": "PayrollTemplate", "description": "Saved payroll templates for employee groups" }
  }
}
